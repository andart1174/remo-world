rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == resource.data.email);
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'andart1174@gmail.com' && request.auth.token.email_verified != false) ||
        request.auth.token.admin == true
      );
    }

    // 1. Social Feed Posts (Strict HTML Mini-App Admin Gate & Citizen Interaction Field Whitelist)
    match /remo_posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.authorUid == request.auth.uid ||
          request.resource.data.authorId == request.auth.uid
        ) &&
        (!('mediaType' in request.resource.data) || request.resource.data.mediaType != 'html_app')
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          resource.data.authorUid == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'comments', 'versus', 'poll', 'tipsTotal',
            'cityGuesses', 'leaderboard', 'capsuleWatchers',
            'bounty', 'secretCapsule', 'views', 'mintedCard'
          ])
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.authorUid == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // 2. Citizen Profiles & Passports (Role & Coin Delta Protected + Safe Peer Tipping)
    match /remo_users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('coins' in request.resource.data) || request.resource.data.coins <= 1000)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.resource.data.role != 'admin') &&
        (!('coins' in request.resource.data) || !('coins' in resource.data) || (request.resource.data.coins - resource.data.coins) <= 500)
      ) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'lifetimeCoins']) &&
        (request.resource.data.coins - resource.data.coins) > 0 &&
        (request.resource.data.coins - resource.data.coins) <= 250
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Ecosystem Live State (Scores, Duels, Jukebox, Bottles)
    match /remo_ecosystem/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // 4. 3D Digital City Cards Pool & Auctions
    match /remo_cards/{cardId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // 5. Default Fallback Gatekeeper
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
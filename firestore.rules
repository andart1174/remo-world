rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == resource.data.email);
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'andart1174@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // 1. Social Feed Posts
    match /remo_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // 2. Citizen Profiles & Passports (Role & Coin Delta Protected)
    match /remo_users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('coins' in request.resource.data) || request.resource.data.coins <= 1000)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.resource.data.role != 'admin') &&
        (!('coins' in request.resource.data) || !('coins' in resource.data) || (request.resource.data.coins - resource.data.coins) <= 2500)
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Ecosystem Live State (Scores, Duels, Jukebox, Bottles)
    match /remo_ecosystem/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // 4. 3D Digital City Cards Pool & Auctions
    match /remo_cards/{cardId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // 5. Default Fallback Gatekeeper
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
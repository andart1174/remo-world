rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        userId == 'u_fb_' + request.auth.uid ||
        (resource != null && resource.data != null && (
          (('fbUid' in resource.data) && resource.data.fbUid != '' && resource.data.fbUid == request.auth.uid) ||
          (('email' in resource.data) && request.auth.token.email_verified == true && request.auth.token.email == resource.data.email)
        ))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'andart1174@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true
      );
    }

    function isNotBanned() {
      return isAuthenticated() && (
        (!exists(/databases/$(database)/documents/remo_users/$(request.auth.uid)) ||
          !('banned' in get(/databases/$(database)/documents/remo_users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/remo_users/$(request.auth.uid)).data.banned != true) &&
        (!exists(/databases/$(database)/documents/remo_users/$('u_fb_' + request.auth.uid)) ||
          !('banned' in get(/databases/$(database)/documents/remo_users/$('u_fb_' + request.auth.uid)).data) ||
          get(/databases/$(database)/documents/remo_users/$('u_fb_' + request.auth.uid)).data.banned != true)
      );
    }

    function isUidMatch(val) {
      return isAuthenticated() && (val == request.auth.uid || val == 'u_fb_' + request.auth.uid);
    }

    function isSafeId(val) {
      return val is string && val.matches('^[a-zA-Z0-9_-]{3,90}$');
    }

    // 1. Social Feed Posts (Strict HTML Mini-App, Vault & Versus Admin Gate + Safe ID + Anti-Tamper Interactions)
    match /remo_posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(postId) &&
        (
          isUidMatch(request.resource.data.uid) ||
          isUidMatch(request.resource.data.authorUid) ||
          isUidMatch(request.resource.data.authorId)
        ) &&
        (!('mediaType' in request.resource.data) || (request.resource.data.mediaType != 'html_app' && request.resource.data.mediaType != 'city_versus')) &&
        (!('htmlCode' in request.resource.data) || request.resource.data.htmlCode == '') &&
        (!('vaultPayload' in request.resource.data) || request.resource.data.vaultPayload == '') &&
        (!('hasVaultApp' in request.resource.data) || request.resource.data.hasVaultApp == false) &&
        (!('isArcadeGame' in request.resource.data) || request.resource.data.isArcadeGame == false) &&
        (!('duetOf' in request.resource.data) || request.resource.data.duetOf == null || (
          (!('htmlCode' in request.resource.data.duetOf) || request.resource.data.duetOf.htmlCode == '') &&
          (!('vaultPayload' in request.resource.data.duetOf) || request.resource.data.duetOf.vaultPayload == '') &&
          (!('mediaType' in request.resource.data.duetOf) || request.resource.data.duetOf.mediaType != 'html_app')
        )) &&
        (!('pinned' in request.resource.data) || request.resource.data.pinned == false) &&
        (!('founderAward' in request.resource.data) || request.resource.data.founderAward == false)
      );
      allow update: if isAdmin() || (
        isNotBanned() && (
          (
            (isUidMatch(resource.data.uid) || isUidMatch(resource.data.authorUid) || isUidMatch(resource.data.authorId)) &&
            (!('pinned' in request.resource.data) || (('pinned' in resource.data) && request.resource.data.pinned == resource.data.pinned) || request.resource.data.pinned == false) &&
            (!('founderAward' in request.resource.data) || (('founderAward' in resource.data) && request.resource.data.founderAward == resource.data.founderAward) || request.resource.data.founderAward == false) &&
            (!('mediaType' in request.resource.data) || (request.resource.data.mediaType != 'html_app' && request.resource.data.mediaType != 'city_versus')) &&
            (!('htmlCode' in request.resource.data) || request.resource.data.htmlCode == '') &&
            (!('vaultPayload' in request.resource.data) || request.resource.data.vaultPayload == '') &&
            (!('hasVaultApp' in request.resource.data) || request.resource.data.hasVaultApp == false) &&
            (!('isArcadeGame' in request.resource.data) || request.resource.data.isArcadeGame == false) &&
            (!('duetOf' in request.resource.data) || request.resource.data.duetOf == null || (
              (!('htmlCode' in request.resource.data.duetOf) || request.resource.data.duetOf.htmlCode == '') &&
              (!('vaultPayload' in request.resource.data.duetOf) || request.resource.data.duetOf.vaultPayload == '') &&
              (!('mediaType' in request.resource.data.duetOf) || request.resource.data.duetOf.mediaType != 'html_app')
            )) &&
            (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
            (!('authorUid' in resource.data) || request.resource.data.authorUid == resource.data.authorUid)
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likes', 'comments', 'versus', 'poll', 'tipsTotal',
              'cityGuesses', 'leaderboard', 'capsuleWatchers',
              'bounty', 'secretCapsule', 'views', 'mintedCard'
            ]) &&
            (!('comments' in resource.data) || !('comments' in request.resource.data) || (request.resource.data.comments is list && request.resource.data.comments.size() >= resource.data.comments.size() && request.resource.data.comments.size() <= resource.data.comments.size() + 1)) &&
            (!('likes' in resource.data) || !('likes' in request.resource.data) || (request.resource.data.likes is list && request.resource.data.likes.size() >= resource.data.likes.size() - 1 && request.resource.data.likes.size() <= resource.data.likes.size() + 1)) &&
            (!('tipsTotal' in resource.data) || !('tipsTotal' in request.resource.data) || (request.resource.data.tipsTotal >= resource.data.tipsTotal && (request.resource.data.tipsTotal - resource.data.tipsTotal) <= 1000)) &&
            (!('views' in resource.data) || !('views' in request.resource.data) || (request.resource.data.views >= resource.data.views && (request.resource.data.views - resource.data.views) <= 5))
          )
        )
      );
      allow delete: if isAuthenticated() && (
        isUidMatch(resource.data.uid) ||
        isUidMatch(resource.data.authorUid) ||
        isUidMatch(resource.data.authorId) ||
        isAdmin()
      );
    }

    // 1A. Private HTML Mini-App Vault & Server Economy Security Claims (Zero Public Read/Write!)
    match /remo_html_vault/{postId} {
      allow read, write: if isAdmin();
    }

    match /remo_security_claims/{claimId} {
      allow read, write: if false;
    }

    // 1B. 24h Stories & Focus Study Rooms
    match /remo_stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(storyId) &&
        (isUidMatch(request.resource.data.uid) || isUidMatch(request.resource.data.authorUid))
      );
      allow update: if isAdmin() || (
        isNotBanned() && (
          isUidMatch(resource.data.uid) ||
          isUidMatch(resource.data.authorUid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'tipsCoins', 'views', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          isUidMatch(resource.data.uid) ||
          isUidMatch(resource.data.authorUid)
        )
      );
    }

    match /remo_focus_rooms/{roomId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isNotBanned() && isSafeId(roomId));
      allow delete: if isAdmin();
    }

    // 2. Citizen Profiles & Passports (Role, Ban, Verified, Private Email Exclusion, UID & Coin Delta Protected)
    match /remo_users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(userId) &&
        isUidMatch(userId) &&
        !('email' in request.resource.data) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'citizen') &&
        (!('banned' in request.resource.data) || request.resource.data.banned == false) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('coins' in request.resource.data) || (request.resource.data.coins >= 0 && request.resource.data.coins <= 250))
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isNotBanned() &&
        !('email' in request.resource.data) &&
        (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('fbUid' in resource.data) || resource.data.fbUid == '' || request.resource.data.fbUid == resource.data.fbUid) &&
        (!('role' in request.resource.data) || (('role' in resource.data) && request.resource.data.role == resource.data.role) || (!('role' in resource.data) && request.resource.data.role == 'citizen')) &&
        (!('banned' in request.resource.data) || (('banned' in resource.data) && request.resource.data.banned == resource.data.banned) || (!('banned' in resource.data) && request.resource.data.banned == false)) &&
        (!('verified' in request.resource.data) || (('verified' in resource.data) && request.resource.data.verified == resource.data.verified) || (!('verified' in resource.data) && request.resource.data.verified == false)) &&
        (!('coins' in request.resource.data) || (
          request.resource.data.coins >= 0 && (
            !('coins' in resource.data) ||
            request.resource.data.coins <= resource.data.coins || (
              (request.resource.data.coins - resource.data.coins) <= 350 &&
              request.resource.data.updatedAt == request.time &&
              request.resource.data.lastCoinWriteAt == request.time &&
              (!('lastCoinWriteAt' in resource.data) || request.time > resource.data.lastCoinWriteAt + duration.value(4, 's'))
            )
          )
        ))
      ) || (
        isNotBanned() &&
        !isOwner(userId) &&
        ('coins' in resource.data) &&
        ('coins' in request.resource.data) &&
        (resource.data.coins is int || resource.data.coins is float) &&
        (request.resource.data.coins is int || request.resource.data.coins is float) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'lifetimeCoins', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (!('updatedAt' in resource.data) || request.time > resource.data.updatedAt + duration.value(4, 's')) &&
        (request.resource.data.coins - resource.data.coins) > 0 &&
        (request.resource.data.coins - resource.data.coins) <= 250 &&
        (!('lifetimeCoins' in resource.data) || !('lifetimeCoins' in request.resource.data) || (
          request.resource.data.lifetimeCoins >= resource.data.lifetimeCoins &&
          (request.resource.data.lifetimeCoins - resource.data.lifetimeCoins) <= (request.resource.data.coins - resource.data.coins)
        ))
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // 2B. Private User Contact Vault (Email stored privately for Owner & Admin only)
    match /remo_users_private/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Ecosystem Live State & Admin-Protected Public Config
    match /remo_ecosystem/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isNotBanned() &&
        docId == 'live_state' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'settings', 'supportTickets', 'adminPin', 'adminPinHash', 'adminEmail',
          'deletedUserIds', 'deletedDuelIds', 'deletedAuctionIds', 'deletedStoryIds',
          'deletedPostIds', 'customCities', 'cityMayors', 'posts', 'gamesHub'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cityScores', 'duels', 'bottles', 'jukeboxTracks', 'auctions',
          'geoVaults', 'stories', 'viralContests', 'worldSystems',
          'remoOdyssey', 'worldSpotlight', 'updatedAt'
        ]) &&
        (!('cityScores' in resource.data) || !('cityScores' in request.resource.data) || (request.resource.data.cityScores is map && request.resource.data.cityScores.size() >= resource.data.cityScores.size())) &&
        (!('geoVaults' in resource.data) || !('geoVaults' in request.resource.data) || (request.resource.data.geoVaults is list && request.resource.data.geoVaults.size() >= resource.data.geoVaults.size())) &&
        (!('duels' in resource.data) || !('duels' in request.resource.data) || (request.resource.data.duels is list && request.resource.data.duels.size() >= resource.data.duels.size())) &&
        (!('auctions' in resource.data) || !('auctions' in request.resource.data) || (request.resource.data.auctions is list && request.resource.data.auctions.size() >= resource.data.auctions.size())) &&
        (!('viralContests' in resource.data) || !('viralContests' in request.resource.data) || (request.resource.data.viralContests is list && request.resource.data.viralContests.size() >= resource.data.viralContests.size()))
      );
      allow delete: if isAdmin();
    }

    match /remo_public_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. 3D Digital City Cards Pool & Auctions
    match /remo_cards/{cardId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(cardId) &&
        isUidMatch(request.resource.data.ownerUid) &&
        (!('rarity' in request.resource.data) || (request.resource.data.rarity != 'Founder 1-of-1' && request.resource.data.rarity != 'Sovereign 1-of-1')) &&
        (!('coinValue' in request.resource.data) || (request.resource.data.coinValue >= 0 && request.resource.data.coinValue <= 10000))
      );
      allow update: if isAdmin() || (isNotBanned() && (!('ownerUid' in resource.data) || isUidMatch(resource.data.ownerUid)));
      allow delete: if isAdmin();
    }

    // 5. Private Direct Messages, Notifications & Support Tickets
    match /remo_direct_messages/{dmId} {
      allow read: if isAdmin() || isUidMatch(resource.data.fromUid) || isUidMatch(resource.data.toUid);
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(dmId) && (
          isUidMatch(request.resource.data.fromUid) ||
          (request.resource.data.fromUid == 'u_system_treasury' && isUidMatch(request.resource.data.toUid)) ||
          (request.resource.data.toUid == 'u_admin_founder' && request.resource.data.fromUid == 'u_support_desk')
        )
      );
      allow update: if isAdmin() || (
        isNotBanned() && (isUidMatch(resource.data.toUid) || isUidMatch(resource.data.fromUid))
      );
      allow delete: if isAdmin() || (isAuthenticated() && isUidMatch(resource.data.fromUid));
    }

    match /remo_notifications/{notifId} {
      allow read: if isAdmin() || isUidMatch(resource.data.toUid);
      allow create: if isAdmin() || (
        isNotBanned() &&
        isSafeId(notifId) && (
          isUidMatch(request.resource.data.fromUid) ||
          (request.resource.data.toUid == 'u_admin_founder' && ('fromUid' in request.resource.data) && isSafeId(request.resource.data.fromUid))
        )
      );
      allow update: if isAdmin() || (isNotBanned() && isUidMatch(resource.data.toUid));
      allow delete: if isAdmin();
    }

    match /remo_support_tickets/{ticketId} {
      allow read: if isAdmin() || isUidMatch(resource.data.uid);
      allow create: if isSafeId(ticketId) && (
        (isNotBanned() && isUidMatch(request.resource.data.uid)) ||
        (!isAuthenticated() && request.resource.data.uid is string && request.resource.data.uid.matches('^u_visitor_[0-9]+$'))
      ) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1850;
      allow update, delete: if isAdmin();
    }

    match /remo_presence/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isOwner(userId) && isNotBanned());
      allow delete: if isAdmin();
    }

    // 6. Default Fallback Gatekeeper (Deny all unspecified collections)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
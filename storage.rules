rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && folder.matches('remo_.*')
        && request.resource != null
        && request.resource.size <= 30 * 1024 * 1024
        && (
          (request.resource.contentType.matches('image/.*') && !request.resource.contentType.matches('image/svg\\+xml.*')) ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*')
        );
      allow delete: if request.auth != null && (
        (request.auth.token.email == 'andart1174@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true
      );
    }
  }
}
